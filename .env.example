# Ollama Cloud API Configuration
# Get your API key from https://api.ollama.com
# For Vite/Vercel deployments, use VITE_ prefix for client-side access
VITE_OLLAMA_BASE_URL=https://api.ollama.com
VITE_OLLAMA_API_KEY=ollama_sk_your_key_here

# Server-side variables (for Vercel serverless function)
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_API_KEY=ollama_sk_your_key_here
